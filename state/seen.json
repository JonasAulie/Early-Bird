      {
        "headline": "Eni – Signs HVO biofuel supply agreement with BMW Group for corporate fleets",
        "comment": "Eni's Enilive unit and BMW Group have signed an agreement under which Enilive will supply HVO (hydrotreated vegetable oil) diesel biofuel to power BMW Group's corporate fleets. No financial terms, volumes or timeline were disclosed.",
        "company": "Eni",
        "url": "https://www.eni.com/en-IT/media/press-release/2026/07/eni-bmw-group-an-agreement-enilive-hvo-diesel-biofuel.html",
        "source_title": "13 July 2026 - 1:00 PM CESTEni and BMW Group: an agreement for Enilive HVO diesel biofuel to power corporate fleets"
      },
      {
        "headline": "Field Development – Aramco launches bid process for the sixth phase of the Jafurah gas project",
        "comment": "Aramco this week launched the bid process for the next development phase of its Jafurah unconventional gas project, valued at more than USD 100bn. Recoverable resources across the field are estimated at 229 trillion cubic feet. No further financial or timeline details were disclosed.",
        "company": "Saudi Aramco",
        "url": "http://www.bing.com/news/apiclick.aspx?ref=FexRss&aid=&tid=6a54d2d30f9842f9ac88e40038845b29&url=https%3a%2f%2fwww.upstreamonline.com%2ffield-development%2faramco-launches-fresh-development-phase-at-100-billion-plus-gas-project%2f2-1-2015365&c=15937644219798188412&mkt=en-us",
        "source_title": "Aramco launches fresh development phase at $100 billion-plus gas project"
      },
      {
        "headline": "Halliburton – Wins integrated drilling and completions contracts for GranMorgu, offshore Suriname",
        "comment": "Halliburton announced today that it has won integrated drilling and completions contracts for the GranMorgu deepwater development offshore Suriname, operated by TotalEnergies. The agreement covers a long-term drilling and completions program using an integrated, digital and automation execution model, and forms part of a global alliance between Halliburton, TotalEnergies and Noble. As part of the scope, Halliburton upgraded its liquid mud and cement plant locally and supported construction of Suriname's first completions and drilling workshop. No contract value was disclosed.",
        "company": "Halliburton",
        "url": "https://www.halliburton.com/en/about-us/press-release/halliburton-wins-integrated-drilling-completions-contract-granmorgu-suriname-total-energies",
        "source_title": "Halliburton wins integrated drilling and completions contracts for GranMorgu deepwater development offshore Suriname, operated by TotalEnergies"
      },
      {
        "headline": "TGS (Hold) – Signs collaboration agreement with Allton on OBN technology",
        "comment": "TGS and Allton today announced a strategic collaboration agreement to accelerate deployment of deepwater ocean-bottom node (OBN) deployment and recovery technology. Under a confidential financial arrangement, TGS secures exclusive rights and priority access to Allton A1 units, establishing a basis for the companies to bring next-generation OBN acquisition capabilities to the industry. No financial terms were disclosed.",
        "company": "TGS",
        "url": "https://www.tgs.com/press-releases/tgs-and-allton-announce-agreement-to-accelerate-obn-operations",
        "source_title": "TGS and Allton Announce Agreement to Accelerate OBN Operations"
      },
      {
        "headline": "Noram Drilling – Reports June rig utilisation and increased cash distribution",
        "comment": "Noram Drilling reported that in June 2026 it had 11 of 11 rigs employed, with rig utilisation of 97%. As of 8 July 2026, 100% of available rig days for July are contracted, and contracted backlog beyond July stands at approximately USD 26.9m, a significant increase from the prior month. The company also flagged an increased cash distribution for July 2026.",
        "company": "Noram Drilling",
        "url": "https://noramdrilling.com/index.php/2026/07/10/noram-drilling-as-monthly-rig-update-and-key-information-relating-to-the-increased-cash-distribution-for-july-2026/",
        "source_title": "NorAm Drilling AS – Monthly rig update and key information relating to the increased cash distribution for July 2026"
      },
      {
        "headline": "Cadeler (Hold) – Signs EUR 247m EIFO-backed green loan for Wind Apex newbuild",
        "comment": "Cadeler announced today that it has signed an EIFO-backed senior secured green term loan facility of EUR 247m to help finance construction of its third A-class newbuild offshore wind installation vessel, Wind Apex, with delivery expected in Q2 2027. The 12-year facility is designated as green financing under Cadeler's Green Finance Framework, with HSBC Singapore acting as Coordinator, Mandated Lead Arranger, Facility Agent, Security Agent and EIFO Agent. The lending syndicate also includes KfW IPEX-Bank, Coöperatieve Rabobank U.A. and DNB Bank ASA.",
        "company": "Cadeler",
        "url": "https://newsweb.oslobors.no/message/678063",
        "source_title": "Cadeler announces signing of an EIFO-backed green term loan facility of EUR 247 million for Wind Apex"
      }
    ]
  }
